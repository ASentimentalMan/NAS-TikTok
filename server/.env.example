APP_NAME=NAS-TikTok
LOG_LEVEL=info
LISTEN_HOST=127.0.0.1
LISTEN_PORT=3000
APP_URL_PREFIX=
API_BASE=
MEDIA_ROOT=../static
DB_PATH=./db/nas-tiktok.db
STATIC_ROOT=../client/dist
ACCOUNT=replace-with-your-account
PASSWORD=replace-with-your-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE=1200
ALLOW_IPv6=false
ALLOWED_IPS=
TRUSTED_PROXIES=
SSL=false
COOKIE_SECURE=false
# Use "none" only for cross-site API deployments; it requires COOKIE_SECURE=true and HTTPS.
COOKIE_SAME_SITE=lax
CORS_ORIGINS=
TLS_CERT_FILE=../certs/fullchain.pem
TLS_KEY_FILE=../certs/privkey.pem
